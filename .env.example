# Copy to .env.workbench.local; never commit credentials.
# Model calls currently support official DashScope / workspace MaaS endpoints.
# Use a key, chat model and embedding model available in the same region.
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Existing local Neo4j, or the container created by quick_start.md.
PLAYGROUND_NEO4J_URI=bolt://127.0.0.1:7687
PLAYGROUND_NEO4J_USER=neo4j
PLAYGROUND_NEO4J_PASSWORD=replace-with-a-strong-database-password
PLAYGROUND_NEO4J_DATABASE=neo4j
PLAYGROUND_PUMP_ONLY=1

# Optional: let restart_workbench.py start this existing Docker container.
# Requires permission to run Docker; omit when another administrator manages it.
# WORKBENCH_NEO4J_CONTAINER=kg-graphrag-neo4j
