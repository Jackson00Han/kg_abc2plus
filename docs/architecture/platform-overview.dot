digraph Platform {
  graph [rankdir=TB, newrank=true, bgcolor="#FAFBFC", pad="0.4", nodesep="0.42", ranksep="0.65", splines=polyline, fontname="PingFang SC", fontsize=24, labelloc=t, label="工业智能对话分析平台\n目标架构 · 母线槽首个闭环 / 后续扩展真空断路器等领域\n", compound=true];
  node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=14, margin="0.20,0.15", color="#95A4B4", fillcolor="#EDF3FA", fontcolor="#23384C", penwidth=1.2];
  edge [fontname="PingFang SC", fontsize=11, color="#798897", fontcolor="#455C70", arrowsize=0.7, penwidth=1.1];

  business [label="平台业务交互\n对话 · 诊断报告 · 决策支持"];
  common [label="平台公共合同与服务治理\n身份/授权 · 稳定对象 ID · 版本 · 证据 · 时间/单位 · 预算/状态", fillcolor="#E5ECF4"];
  deer [label="DeerFlow / Agent 编排\n领域路由 · 任务计划 · 工具调用 · 最终答案与引用检查", fillcolor="#DFEAF6", penwidth=1.8];
  llm [label="模型服务：LLM / embedding\n供编排与知识构建/检索使用\n按权限与用途调用", fontsize=12];
  business -> common;
  common -> deer;
  llm -> deer [style=dashed, label="模型能力", constraint=false];

  subgraph cluster_kb {
    label="本项目负责：知识与知识图谱能力层";
    fontname="PingFang SC"; fontsize=19; fontcolor="#175B48"; color="#38856C"; fillcolor="#ECF7F0"; style="rounded,filled"; penwidth=2; margin=24;
    node [fillcolor="#FFFFFF", color="#77A990", fontcolor="#1D503E"];
    kapi [label="受控知识 API / Agent 对接准备\n知识检索 · 图查询 · 来源与证据", penwidth=1.6];
    retrieve [label="本体语义与知识检索\n分类/适用范围 · 有限派生 · 冲突与缺口"];
    storage [label="发布快照与证据存储\nNeo4j 属性图 · 检索索引\n不可变文档/Chunk/结构化源定位"];
    govern [label="构建、身份与审核发布\n本体/知识条目 · 映射 · 校验 · 版本/撤回"];
    workbench [label="知识工作台\n来源 · 本体 · 构建 · 图谱 · 证据 · 质量"];
    kapi -> retrieve;
    retrieve -> storage;
    govern -> storage [label="发布投影", constraint=false];
    workbench -> govern;
    kapi -> govern [style=invis];
  }

  subgraph cluster_analysis {
    label="外部：领域分析与工具";
    fontname="PingFang SC"; fontsize=18; fontcolor="#35516E"; color="#9DB1C5"; fillcolor="#F0F4FA"; style="rounded,filled"; margin=22;
    diagnose [label="领域分析接口\n适用性 · 计算 · 诊断 · 根因判定"];
    executor [label="规则执行与分析工具\n质量/拓扑门禁 · 时间窗口 · 统计/算法"];
    rules [label="可执行规则与参数注册\n规则制品版本 ↔ 知识条款版本\n工程参数 · 适用环境"];
    runs [label="分析执行记录\n数据/参数/规则版本 · 结果与证据"];
    diagnose -> executor;
    executor -> rules [label="执行依据"];
    executor -> runs [label="记录"];
  }

  subgraph cluster_data {
    label="外部：工业数据与适配";
    fontname="PingFang SC"; fontsize=18; fontcolor="#35516E"; color="#9DB1C5"; fillcolor="#F0F4FA"; style="rounded,filled"; margin=22;
    data [label="受控数据查询接口\n对象/测点 · 时间窗口 · 单位/质量"];
    binding [label="物理绑定与数据适配\n点位/设备映射 · provider · 协议 · 凭据"];
    systems [label="工业源系统\n时序/告警 · 资产与工程配置\n参数来源 · 数据快照"];
    data -> binding;
    binding -> systems;
  }

  deer -> kapi [label="知识证据"];
  deer -> diagnose [label="对象/时间 + 知识上下文"];
  deer -> data [label="必要时查数据"];
  diagnose -> data [label="按规则取数", constraint=false];
  {rank=same; kapi; diagnose; data;}

  subgraph cluster_inputs {
    label="领域包与来源：各层分别消费，内容不硬编码在平台中";
    fontname="PingFang SC"; fontsize=16; fontcolor="#725923"; color="#C8B276"; fillcolor="#FCF7E9"; style="rounded,filled"; margin=20;
    node [fillcolor="#FFFDF6", color="#C8B276", fontcolor="#695529", fontsize=12];
    knowledge [label="入知识库\n本体 · 领域条目 · 规则正文\n授权拓扑版本 · 原始证据 · 已审核案例"];
    importconfig [label="知识构建配置\n知识包清单 · XML/YAML 映射\n样本验收基线"];
    runconfig [label="外部运行配置与数据\n可执行规则 · 有效参数\npoint_mapping · 时序快照"];
    {rank=same; knowledge; importconfig; runconfig;}
  }

  govern -> knowledge [dir=back, label="入库资料"];
  govern -> importconfig [dir=back, label="导入配置"];
  rules -> runconfig [dir=back, label="外部管理"];
  binding -> runconfig [dir=back, constraint=false];
  runs -> knowledge [style=dashed, label="仅复核后沉淀案例", constraint=false];

  evaluation [label="分层评估与平台闭环验收\n本项目：知识/引用/权限/生命周期　｜　外部：数据/规则/编排/最终答案\n统一 trace 与版本用于复现；日志/测试 Gold 不作为业务知识", fillcolor="#E9EEF2", color="#9EAAB3", fontsize=13];
  knowledge -> evaluation [style=invis];
  importconfig -> evaluation [style=invis];
  runconfig -> evaluation [style=invis];
  legend [shape=plain, style="", label="绿色：本项目建设范围　　蓝色：外部对接能力　　黄色：输入及配置\n逻辑架构，不代表已部署；知识查询可独立完成，诊断按需调用外部数据与工具。", fontsize=12, fontcolor="#667887"];
  evaluation -> legend [style=invis];
}
