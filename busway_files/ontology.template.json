      ],
      "constraint_combination": "intersection_no_silent_weakening",
      "conflicting_constraints": "reject",
      "instance_values_and_relationships": "never_inherit_from_other_instances",
      "composition_is_subtyping": false
    },
    "concept_hierarchies": {}
  },
  "relation_categories": {
    "location": {
      "display_name": "位置关系",
      "definition": "表达对象与空间或场所的关系。分类本身不产生任何连边。"
    }
  },
  "relation_types": {
    "LOCATED_AT": {
      "display_name": "位于",
      "definition": "记录某个对象在给定上下文中的所在场所。",
      "category": "location",
      "direction": "directed",
      "canonical_storage": "forward_only",
      "inverse_traversal": "query_only",
      "from": {
        "endpoint_kind": "entity",
        "allowed_types": [
          "ExampleAsset"
        ]
      },
      "to": {
        "endpoint_kind": "entity",
        "allowed_types": [
          "ExampleSite"
        ]
      },
      "allowed_type_pairs": [
        {
          "from": "ExampleAsset",
          "to": "ExampleSite"
        }
      ],
      "cardinality": {
        "outgoing_per_source": {
          "min": 0,
          "max": null
        },
        "incoming_per_target": {
          "min": 0,
          "max": null
        },
        "scope": "same_project_configuration_and_overlapping_validity"
      },
      "statement_semantics": {
        "scope_kind": "instance",
        "statement_kind": "fact_statement",
        "modality": "asserted"
      },
      "property_schema": {
        "$ref": "#/property_definitions/relation_types/LOCATED_AT"
      }
    }
  },
  "property_definitions": {
    "value_types": [
      "string",
      "integer",
      "number",
      "boolean",
      "date",
      "datetime",
      "duration",
      "uri",
      "object",
      "array[string]",
      "array[object]"
    ],
    "semantics": {
      "required": "property_presence",
      "array_min_max_items": "collection_length_not_property_presence",
      "required_when": "additional_conditional_presence_constraint",
      "required_when_accepted_forms": {
        "predicate_object": {
          "property": "declared_property_name",
          "operator": [
            "equals",
            "in"
          ],
          "value": "typed_value_or_array"
        },
        "legacy_in_object": "{property_name}_in maps to an in predicate",
        "legacy_equality_string": "only the bounded form property_name == enum_value; never evaluate code"
      },
      "unit": "declared_canonical_unit_preserve_original_value_and_unit_in_evidence",
      "undeclared_properties": "reject",
      "reference_values": "resolve_in_authenticated_namespace",
      "unknown_enum_value": "reject_or_quarantine_when_an_allowed_values_set_is_declared",
      "unit_validation": {
        "numeric_quantity": "require_compatible_unit_when_the_property_declares_a_unit_requirement",
        "canonical_unit_in_property_definition": "may_determine_normalized_unit_while_preserving_original_source_representation",
        "non_numeric_or_dimensionless": "no_blanket_unit_requirement",
        "ambiguous_unit": "reject_or_quarantine_not_guess"
      }
    },
    "entity_types": {
      "ExampleEntity": {},
      "ExampleAsset": {
        "project_id": {
          "value_type": "string",
          "required": true
        },
        "code": {
          "value_type": "string",
          "required": true
        },
        "display_name": {
          "value_type": "string",
          "required": false
        },
        "rated_current": {
          "value_type": "number",
          "required": false,
          "unit": "A",
          "minimum": 0
        },
        "configuration_status": {
          "value_type": "string",
          "required": false,
          "allowed_values": [
            "configured",
            "unconfigured"
          ]
        },
        "configuration_version": {
          "value_type": "string",
          "required": false,
          "required_when": {
            "property": "configuration_status",
            "operator": "equals",
            "value": "configured"
          }
        },
        "tags": {
          "value_type": "array[string]",
          "required": false,
          "min_items": 0,
          "max_items": 32
        }
      },
      "ExampleSite": {
        "project_id": {
          "value_type": "string",
          "required": true
        },
        "code": {
          "value_type": "string",
          "required": true
        },
        "display_name": {
          "value_type": "string",
          "required": false
        }
      }
    },
    "relation_types": {
      "LOCATED_AT": {
        "position_note": {
          "value_type": "string",
          "required": false
        }
      }
    }
  },
  "identity_constraints": {
    "application_ids": {
      "entities": "entity_id",
      "statements": "assertion_id",
      "relationships": "relationship_id",
      "property_values": "property_value_id",
      "neo4j_element_id_as_persistent_identity": false,
      "reimport_and_retry": "stable_and_idempotent",
      "tenant_scope": "server_supplied"
    },
    "entity_identity": {
      "ExampleAsset": {
        "uniqueness_scope": [
          "tenant_id",
          "project_id",
          "entity_type"
        ],
        "business_key_properties": [
          "code"
        ],
        "identity_assignment": "stable_application_registry"
      },
      "ExampleSite": {
        "uniqueness_scope": [
          "tenant_id",
          "project_id",
          "entity_type"
        ],
        "business_key_properties": [
          "code"
        ],
        "identity_assignment": "stable_application_registry"
      }
    },
    "relationship_identity": {
      "stable_application_id_required": true,
      "required_for_direct_and_derived_relationships": true,
      "aggregate_relationship_id_distinct_from_supporting_assertion_ids": true,
      "endpoint_triple_alone_identifies_evidence_revision": false,
      "different_sources_and_contexts": "retain_separate_assertions_and_evidence"
    },
    "resolution": {
      "same_label_or_name_is_sufficient": false,
      "business_key_change": "audited_identity_mapping_preserving_history",
      "unsupported_identity": "quarantine_not_guess"
    }
  },
  "statement_model": {
    "definition": "每条记录表达一个可追溯的知识陈述；陈述可指向实体、关系或某个属性值。事实陈述表示来源这样声称，是否认可另由治理状态决定。",
    "record_id": "assertion_id",
    "subjects": [
      "entity",
      "entity_type",
      "relationship"
    ],
    "objects": [
      "entity",
      "entity_type",
      "typed_literal"
    ],
    "required_fields": [
      "assertion_id",
      "subject",
      "predicate",
      "object",
      "semantics",
      "provenance"
    ],
    "semantics": {
      "scope_kind": [
        "instance",
        "type_general",
        "concept_general"
      ],
      "statement_kind": [
        "fact_statement",
        "general_knowledge",
        "requirement",
        "candidate_explanation"
      ],
      "modality": [
        "asserted",
        "possible",
        "required"
      ],
      "polarity": [
        "positive",
        "negative"
      ],
      "independent_of": [
        "origin",
        "authority",
        "governance_status"
      ],
      "defaults": "do_not_invent_missing_required_semantics",
      "scope_kind_definitions": {
        "instance": "涉及具体工程对象、配置或范围实例的陈述；statement_kind 仍区分事实和要求。",
        "type_general": "以实体类型为适用对象的一般性陈述；端点明确引用类型注册表。",
        "concept_general": "领域知识概念之间的通用陈述；概念虽然以实体记录存储，但不表示某台设备的事实。"
      }
    },
    "context_fields": {
      "project_id": {
        "value_type": "string",
        "required": false
      },
      "applicable_type_ids": {
        "value_type": "array[string]",
        "required": false,
        "reference_kind": "entity_type"
      },
      "scope_entity_ids": {
        "value_type": "array[string]",
        "required": false,
        "reference_kind": "entity"
      },
      "configuration_version": {
        "value_type": "string",
        "required": false
      },
      "valid_from": {
        "value_type": "datetime",
        "required": false
      },
      "valid_to": {
        "value_type": "datetime",
        "required": false
      },
      "observed_at": {
        "value_type": "datetime",
        "required": false
      },
      "operating_conditions": {
        "value_type": "array[object]",
        "required": false
      },
      "rule_version": {
        "value_type": "string",
        "required": false
      }
    },
    "context_policy": {
      "absent_context": "unknown_or_not_stated_not_universal_applicability",
      "time_range": "valid_from_precedes_valid_to_when_both_present",
      "conditions": "typed_predicates_with_declared_operators_no_arbitrary_code",
      "missing_evidence": "unknown_not_false",
      "applicability_match_required_before_using_general_knowledge": true,
      "same_name_implies_same_entity_or_class": false
    },
    "type_general_knowledge": {
      "entity_type_reference": "same_type_registry_as_entity_types",
      "retrieval": "resolve_entity_type_then_return_applicable_general_statements_with_qualifiers",
      "presentation": "preserve_type_general_scope_and_modality",
      "copy_to_instance_fact_edges": false,
      "copy_specific_other_instance_property_values": false
    },
    "provenance": {
      "evidence": {
        "$ref": "#/governance_constraints/evidence"
      },
      "source_authority": {
        "$ref": "#/governance_constraints/source_authority"
      },
      "origin": [
        "EXPERT_IMPORT",
        "EXPERT_CREATED",
        "LLM_EXTRACTED",
        "AUTHORITATIVE_EXTRACTED",
        "HUMAN_SUPPLEMENT",
        "RULE_DERIVED",
        "FIXTURE"
      ],
      "governance_status": [
        "CANDIDATE",
        "APPROVED",
        "PUBLISHED",
        "QUARANTINED",
        "REJECTED",
        "SUPERSEDED"
      ],
      "confidence": {
        "value_type": "number",
        "minimum": 0,
        "maximum": 1,
        "meaning": "extraction_or_assertion_confidence_not_authority"
      }
    },
    "storage_contract": "Reuse governed mention/assertion/value revision records; property graph need not create a business node for every statement."
  },
  "governance_constraints": {
    "source_authority": {
      "levels": {
        "AUTHORITATIVE": {
          "display_name": "权威"
        },
        "SECONDARY": {
          "display_name": "次权威"
        }
      },
      "assigned_by": "document_upload_selection",
      "upload_field": "knowledge_scope",
      "upload_value_mapping": {
        "AUTHORITATIVE": "AUTHORITATIVE",
        "BUSINESS": "SECONDARY"
      },
      "propagation": "inherit_document_authority_for_source_extracted_information",
      "applies_to": [
        "entity_identity_assertion",
        "entity_type_assertion",
        "relationship_assertion",
        "entity_property_assertion",
        "relationship_property_assertion"
      ],
      "stored_fields": {
        "api": "trust.authority",
        "graph_and_storage": "authority_level"
      },
      "missing_selection": {
        "upload_default": "BUSINESS",
        "authority": "SECONDARY"
      },
      "authority_from_ontology_file_content": "forbidden",
      "source_grade_change": "new_governed_revision_preserving_previous_evidence",
      "multi_source": {
        "retain_authority_per_source_assertion": true,
        "entity_display_aggregation": "authority_levels",
        "relationship_display_aggregation": "authority_levels",
        "overwrite_all_information_on_entity": false,
        "property_inheritance": "inherit_own_evidence_source_or_same_source_enclosing_assertion",
        "highest_grade_silently_resolves_conflict": false
      },
      "formation_and_review": {
        "separate_fields": [
          "origin",
          "authority",
          "status"
        ],
        "review_changes_authority": false,
        "authority_implies_approved_or_published": false,
        "extraction_confidence_is_source_authority": false
      },
      "current_service_binding": {
        "authoritative_upload_requires_scopes": [
          "knowledge:construct",
          "knowledge:import"
        ],
        "authoritative_upload_extraction_modes": [
          "LLM"
        ],
        "origin_to_authority": {
          "EXPERT_IMPORT": "AUTHORITATIVE",
          "EXPERT_CREATED": "AUTHORITATIVE",
          "AUTHORITATIVE_EXTRACTED": "AUTHORITATIVE",
          "LLM_EXTRACTED": "SECONDARY",
          "HUMAN_SUPPLEMENT": "SECONDARY",
          "RULE_DERIVED": "SECONDARY",
          "FIXTURE": "SECONDARY"
        },
        "derived_authority": "SECONDARY",
        "derived_inherits_premise_authority": false,
        "note": "沿用当前服务约束。上传等级传递针对文档抽取信息；规则新派生的陈述仍使用 RULE_DERIVED，不能冒充原文抽取。"
      }
    },
    "evidence": {
      "reference_model": "platform_chunk_evidence_v1",
      "targets": [
        "entity_identity_assertion",
        "entity_type_assertion",
        "relationship_assertion",
        "entity_property_assertion",
        "relationship_property_assertion"
      ],
      "direct_evidence_required_fields": [
        "document_id",
        "version_id",
        "chunk_id",
        "char_start",
        "char_end",
        "quoted_text"
      ],
      "source_resolution": "document_id_resolves_registered_source_id",
      "document_version_resolution": "version_id_resolves_immutable_document_version_and_checksum",
      "range_semantics": "zero_based_half_open_global_character_range_in_canonical_document_text",
      "checks": [
        "document_version_belongs_to_document",
        "chunk_belongs_to_document_version",
        "range_is_nonempty_and_within_chunk",
        "quoted_text_matches_canonical_source_range",
        "referenced_source_supports_the_specific_statement"
      ],
      "structured_source": {
        "optional_locators": [
          "xml_path",
          "json_pointer",
          "yaml_path"
        ],
        "replaces_chunk_evidence": false,
        "canonicalization_and_original_document_version_link_required": true
      },
      "property_granularity": {
        "reference_owner_id_required": true,
        "reference_property_name_required": true,
        "reference_specific_value_or_value_revision_required": true,
        "whole_entity_document_reference_is_sufficient": false
      },
      "derived_evidence": {
        "required": [
          "derivation_rule_id",
          "derivation_rule_version",
          "premise_assertion_ids",
          "input_snapshot_id"
        ],
        "premises_must_resolve_to_chunk_evidence": true,
        "recursion_and_graph_expansion": "bounded_by_platform_policy",
        "claim_direct_source_quote_for_derived_conclusion": false,
        "input_snapshot": {
          "identity": "immutable_server_registered_manifest",
          "contains": [
            "ontology_version",
            "source_document_versions",
            "premise_assertion_revisions",
            "rule_version"
          ],
          "candidate_construction": "candidate_input_snapshot_without_required_prior_publication",
          "published_knowledge": "published_input_snapshot_with_publication_reference"
        },
        "publication_binding": "Bind generated assertion to its publication when published; do not require a future output publication during candidate construction."
      },
      "multiple_sources": "retain_separate_support_and_conflict_records",
      "unresolved_evidence": "not_publishable_as_confirmed_fact",
      "manual_information": "register_versioned_reviewable_source_before_publication",
      "security_context": {
        "supplied_by": "server_authenticated_context",
        "fields": [
          "tenant_id",
          "access_policy_id",
          "access_policy_version",
          "access_groups"
        ],
        "ontology_or_upload_content_may_override": false
      }
    },
    "consistency": {
      "type_reference_closure": true,
      "entity_reference_closure": true,
      "evidence_reference_closure": true,
      "endpoint_type_validation": true,
      "allowed_type_pairs_override_cartesian_product": true,
      "validate_property_values": true,
      "validate_identity": true,
      "conflicts": "retain_and_flag_do_not_silently_overwrite",
      "unsupported_semantics": "reject_activation_not_ignore_fields"
    },
    "semantic_safety": {
      "general_knowledge_implies_instance_fact": false,
      "possible_cause_is_confirmed_diagnosis": false,
      "expected_observable_implies_instrumentation": false,
      "missing_evidence_implies_false": false,
      "runtime_measurements_in_ontology": "forbidden",
      "runtime_diagnostic_results_in_ontology": "forbidden"
    }
  },
  "annotations": {
    "section_guide": {
      "metadata": "1. 本体元信息：合同版本、标识、命名空间、领域、语义依赖与生命周期。",
      "entity_types": "2. 实体类型：稳定类型 ID、定义、别名、语义角色及是否允许实例化。",
      "type_hierarchy": "3. 类型层级：子类型、归类、互斥与继承约束；组成关系不属于类型继承。",
      "relation_categories": "4. 关系分类：分类标识、名称和含义；分类不产生关系继承或实例事实。",
      "relation_types": "5. 关系类型：含义、方向、端点种类、类型组合、基数及受支持的可选语义。",
      "property_definitions": "6. 属性：按实体类型或关系类型分别定义值类型、单位、枚举、范围、必填与集合约束。",
      "identity_constraints": "7. 身份：稳定应用 ID、业务键及唯一性范围；不能仅按名称合并。",
      "statement_model": "8. 知识陈述：陈述内容、类别或实例对象、可能性、否定、条件、项目、时间与配置版本。",
      "governance_constraints": "9. 一致性、来源分级与证据：上传等级传递、逐项引用、语义边界和有效性校验。",
      "annotations": "10. 语义注释：填写说明、语义分层、定义出处、兼容说明；不承载执行规则或页面样式。"
    },
    "template_usage": [
      "本文件是可填写的领域本体示例，不是 JSON Schema，也不是当前 8002 导入请求。",
      "类型、关系及属性所有者均用稳定名称作键；局部 $ref 使用 JSON Pointer。",
      "先修改元信息，再替换 Example 类型、层级、关系、属性和业务键；同步更新引用。",
      "空依赖或互斥集合表示没有声明；不允许据此猜测新的继承、事实或适用条件。",
      "具体资产、诊断知识条目、规则正文、来源版本和 Chunk 引用在入库数据中填写。",
      "实例文件、项目固定计数、XML 选择器、取数地址、执行参数和画图样式不属于本体的加载前提。",
      "source_authority 沿用上传选项；本体文件不能给其自身或全部实例预先授予权威等级。"
    ],
    "semantic_layers": {},
    "definition_provenance": {},
    "reference_patterns": {
      "statements_and_qualifiers": "https://www.mediawiki.org/wiki/Wikibase/DataModel",
      "provenance": "https://www.w3.org/TR/prov-o/",
      "property_graph_constraints": "https://neo4j.com/docs/cypher-manual/current/schema/constraints/",
      "note": "借鉴概念和建模方式；本项目 JSON 合同不声称是上述标准的原生序列化。"
    }
  }
}
