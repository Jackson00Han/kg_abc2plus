    "default_language": "zh-CN",
    "status": "TEMPLATE",
    "title": "通用知识库本体填写模板",
    "domain": "替换为目标工业领域",
    "description": "十部分本体合同模板。替换 Example 类型及示例属性；平台来源等级、证据、身份与语义安全最低约束保持有效。",
    "semantic_dependencies": [],
    "deprecation": {
      "deprecated": false,
      "replaced_by": null
    },
    "canonical_relation_storage": "forward_only",
    "compatibility": {
      "current_8002_ontology_import_supported": false,
      "implementation_status": "design_contract_requires_importer_and_validator_upgrade",
      "native_neo4j_schema": false,
      "standalone_definition_loading": true,
      "instance_files_required_for_ontology_loading": false
    }
  },
  "entity_types": {
    "ExampleEntity": {
      "display_name": "示例对象基类",
      "definition": "占位抽象类型；替换为领域中有明确共同语义的上位类型。",
      "aliases": [],
      "semantic_role": "example",
      "abstract": true,
      "instantiable": false,
      "property_schema": {
        "$ref": "#/property_definitions/entity_types/ExampleEntity"
      }
    },
    "ExampleAsset": {
      "display_name": "示例设备",
      "definition": "占位实体类型；替换为设备或其他业务对象的精确定义。",
      "aliases": [],
      "semantic_role": "example",
      "abstract": false,
      "instantiable": true,
      "property_schema": {
        "$ref": "#/property_definitions/entity_types/ExampleAsset"
      }
    },
    "ExampleSite": {
      "display_name": "示例场所",
      "definition": "占位实体类型；与设备有各自身份和属性。",
      "aliases": [],
      "semantic_role": "example",
      "abstract": false,
      "instantiable": true,
      "property_schema": {
        "$ref": "#/property_definitions/entity_types/ExampleSite"
      }
    }
  },
  "type_hierarchy": {
